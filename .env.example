POSTGRES_DB=temporal_service
POSTGRES_USER=temporal_user
POSTGRES_PASSWORD=change-me
POSTGRES_HOST_PORT=55432

TEMPORAL_API_HOST_PORT=8081
TEMPORAL_PORTAL_HOST_PORT=3002
TEMPORAL_API_PUBLIC_URL=https://timetable-api.example.com
TEMPORAL_PORTAL_PUBLIC_URL=https://timetable.example.com

# Bootstrap/control-plane HMAC used only for first installation registration.
# This must match Scholaroscope TIMETABLE_PLUGIN_BOOTSTRAP_SECRET.
TEMPORAL_SCHOLAROSCOPE_WEBHOOK_SECRET=change-me-bootstrap-secret

# Scholaroscope webhook endpoint receiving temporal outbox events.
SCHOLAROSCOPE_TIMETABLE_WEBHOOK_URL=https://scholaroscope.example.com/api/plugins/timetable/webhook/

# Comma-separated frontend origins allowed to POST launch grants with credentials.
TEMPORAL_CORS_ALLOWED_ORIGINS=https://scholaroscope.example.com
TEMPORAL_PORTAL_COOKIE_SECURE=true

TEMPORAL_OUTBOX_REQUEST_TIMEOUT_SECONDS=10
TEMPORAL_OUTBOX_MAX_ATTEMPTS=8
TEMPORAL_OUTBOX_BATCH_SIZE=25
TEMPORAL_OUTBOX_POLL_SECONDS=30
